{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/render.ts": { "includeFiles": "data/*.json" },
    "api/sitemap.ts": { "includeFiles": "data/*.json" }
  },
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "thecertusgroup.tech" }],
      "status": 308,
      "dest": "https://technical.certusgroup.com/$1"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.thecertusgroup.tech" }],
      "status": 308,
      "dest": "https://technical.certusgroup.com/$1"
    },
    { "src": "/sitemap\\.xml$", "dest": "/api/sitemap" },
    { "src": "/$", "dest": "/api/render?page=home" },
    { "src": "/employers$", "dest": "/api/render?page=employers" },
    { "src": "/jobs$", "dest": "/api/render" },
    { "src": "/jobs/([^/]+)$", "dest": "/api/render?id=$1" },
    { "src": "/submit-resume$", "dest": "/api/render?page=submit-resume" },
    { "src": "/insights$", "dest": "/api/render?page=insights" },
    { "src": "/insights/([^/]+)$", "dest": "/api/render?insight=$1" },
    { "handle": "filesystem" },
    { "src": "/(?!api/).*", "dest": "/index.html" }
  ]
}
